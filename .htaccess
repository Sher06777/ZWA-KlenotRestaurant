Options -MultiViews
RewriteEngine On
RewriteBase /~achilkem/

# -------------------------------------------------------
# 1) Если путь содержит "index.html/..." или "index.js..." → SPA
RewriteRule ^index\.html/ /~achilkem/index.html [L]
RewriteCond %{REQUEST_URI} ^/~achilkem/index\.js.+ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^index\.js.+$ /~achilkem/index.html [L]

# -------------------------------------------------------
# 2) Существующие файлы/директории → отдаём напрямую
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# -------------------------------------------------------
# 3) Любые пути, которые выглядят как файл с расширением → показываем 404 (index.html)
RewriteCond %{REQUEST_URI} \.[a-z0-9]{1,6}$ [NC]
RewriteRule ^ /~achilkem/index.html [L]

# -------------------------------------------------------
# 4) SPA fallback → все остальные маршруты на index.html
RewriteCond %{REQUEST_URI} ^/~achilkem [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /~achilkem/index.html [L]

# -------------------------------------------------------
# 5) ErrorDocument на всякий случай
ErrorDocument 404 /~achilkem/index.html