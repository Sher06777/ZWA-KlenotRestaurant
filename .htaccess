Options -MultiViews
RewriteEngine On
RewriteBase /~base/

# 1) If request targets "index.html/..." or "index.js..." — treat as SPA and serve index.html
RewriteRule ^index\.html/ index.html [L]
RewriteCond %{REQUEST_URI} ^/~base/index\.js.+ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^index\.js.+$ index.html [L]

# 2) Serve existing files and directories directly (needed for PHP, images, JS modules)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3) Pretty routes → redirect to hash routes so client-side router opens the correct section
RewriteRule ^about-us$ #about-us [NE,R=301,L]
RewriteRule ^menu$ #menu [NE,R=301,L]
RewriteRule ^gallery$ #gallery [NE,R=301,L]
RewriteRule ^reservation$ #reservation [NE,R=301,L]
RewriteRule ^signin$ #signin [NE,R=301,L]
RewriteRule ^account$ #account [NE,R=301,L]

# 4) Unknown (non-file/non-dir) paths → serve index.html (keep URL); client-side 404 handler will run
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.html [L]

# 5) Custom 404 handler (falls back to SPA)
ErrorDocument 404 /~base/index.html
